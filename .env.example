# MongoDB (required for ingestion, live scoring, and UI history)
MONGODB_URI=mongodb+srv://...
MONGODB_DATABASE=gk-reports
MONGODB_COLLECTION_ROULETTE_REPORT=roulette_game_report
MONGODB_COLLECTION_USERS=gk_users
LIVE_PREDICTIONS_COLLECTION=live_predictions
ANALYST_LABELS_COLLECTION=analyst_labels
LIVE_SCORING_STATE_COLLECTION=live_scoring_state

# Local Docker service URLs. Compose overrides container-internal URLs where needed.
API_PORT=8000
STREAMLIT_PORT=8501
FRAUD_API_BASE_URL=http://127.0.0.1:8000
GK_BACKEND_API_BASE_URL=https://dev-gkrpt-server.funsports.top
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_UI_URL=http://localhost:5000

# Self-hosted Prefect defaults for local/host tools.
PREFECT_API_URL=http://localhost:4200/api
PREFECT_UI_URL=http://localhost:4200
PREFECT_API_KEY=
PREFECT_POOL_NAME=fraud-pool

# Optional: Slack notifications for Prefect flow failures.
SLACK_WEBHOOK_URL=
